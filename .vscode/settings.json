{
  "editor.formatOnSave": true,
  "stylelint.enable": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "stylelint.validate": [
    "vue",
    "css",
    "less",
    "postcss",
    "scss",
    "sass",
    "html"
  ],
  "files.eol": "\n",
  "vue.codeActions.enabled": false
}
